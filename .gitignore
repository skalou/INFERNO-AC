# Visual Studio and local tooling
.vs/
*.user
*.code-workspace
session-state/
debug_log.txt

# Personal data created by the mod (friends, saves, server keyword lists)
ServerSharedKeywords/

# Game sounds: most are copyrighted extracts and must not be published.
# Only the default alert and example custom sounds are tracked.
sounds/*
!sounds/DefaultAppSounds/
sounds/DefaultAppSounds/*
!sounds/DefaultAppSounds/00defaultALERT.wav
!sounds/MyCustomSoundsEXEMPLE/
sounds/MyCustomSoundsEXEMPLE/*
!sounds/MyCustomSoundsEXEMPLE/*.mp3

# Node modules of the test tools
tools/node_modules/
tools/last-run.txt

# Work-in-progress icon drafts (not part of the release)
# Only app-essential icons are tracked (icon.png, icon_config.png, flag_en.png)
# Icons are stored in root directories: INFERNO-ChatAlerts/ and INFERNO-DEV/
!icon.png
!icon_config.png
!flag_en.png
icons/

# Work-in-progress feature branches (not part of the release)
INFERNO-WIP/
